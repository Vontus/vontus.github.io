---
import Base from '../layouts/Base.astro';
import { m } from '../paraglide/messages.js';
import { localizeHref } from '../paraglide/runtime.js';

type HomeProject = {
  tags: (() => string)[];
  url?: string;
  source?: string;
  closed?: boolean;
};

// Datos estructurales (idénticos en los dos idiomas: orden, urls, si tiene
// código abierto). Los textos (nombre, descripción, tags) viven en mensajes
// home_project_{i}_nombre / _desc / _tag_{j}.
const projects: HomeProject[] = [
  {
    tags: [m.home_project_0_tag_0, m.home_project_0_tag_1],
    url: 'https://tallermartinez.net',
    source: 'https://github.com/Vontus/tallermartinez.dev',
  },
  {
    tags: [m.home_project_1_tag_0, m.home_project_1_tag_1, m.home_project_1_tag_2],
    closed: true,
  },
  {
    tags: [m.home_project_2_tag_0, m.home_project_2_tag_1, m.home_project_2_tag_2],
    url: '/moone',
    closed: true,
  },
  {
    tags: [m.home_project_3_tag_0, m.home_project_3_tag_1],
    url: 'https://vontus.github.io/pinatarius-2026-galeria/',
    source: 'https://github.com/vontus/pinatarius-2026-galeria',
  },
  {
    tags: [m.home_project_4_tag_0, m.home_project_4_tag_1],
    url: 'https://t.me/urbandictionarybot',
    source: 'https://github.com/vontus/UrbanDictionaryBot',
  },
];

const projectNames = [m.home_project_0_nombre, m.home_project_1_nombre, m.home_project_2_nombre, m.home_project_3_nombre, m.home_project_4_nombre];
const projectDescs = [m.home_project_0_desc, m.home_project_1_desc, m.home_project_2_desc, m.home_project_3_desc, m.home_project_4_desc];
---

<Base>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{m.home_eyebrow()}</p>
      <h1>{m.home_h1()}</h1>
      <p class="lead">{m.home_lead()}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={localizeHref('/contacto')}>{m.home_cta_primary()}</a>
      </div>
    </div>
  </section>

  <section id="proyectos">
    <div class="container">
      <h2 class="section-title">{m.home_projects_title()}</h2>
      <p class="section-intro">{m.home_projects_intro()}</p>
      <div class="cards">
        {
          projects.map((p, i) => {
            const nombre = projectNames[i]();
            const href = p.url && p.url.startsWith('/') ? localizeHref(p.url) : p.url;
            return (
              <article class="card">
                <h3>
                  {href ? (
                    p.url!.startsWith('/') ? (
                      <a href={href}>{nombre}</a>
                    ) : (
                      <a href={href} rel="noopener" target="_blank">
                        {nombre}
                      </a>
                    )
                  ) : (
                    nombre
                  )}
                </h3>
                <p>{projectDescs[i]()}</p>
                <div class="card-foot">
                  <div class="tags">
                    {p.tags.map((t) => (
                      <span class="tag">{t()}</span>
                    ))}
                  </div>
                  {p.source ? (
                    <a class="source" href={p.source} rel="noopener" target="_blank">
                      {m.home_project_source_label()}
                    </a>
                  ) : (
                    p.closed && <span class="source closed">{m.home_project_closed_label()}</span>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>
