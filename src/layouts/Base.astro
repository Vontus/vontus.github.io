---
import '../styles/global.css';
import { m } from '../paraglide/messages.js';
import { getLocale, locales, localizeHref, deLocalizeHref } from '../paraglide/runtime.js';

interface Props {
  title?: string;
  description?: string;
}

const { title = m.base_title(), description = m.base_description() } = Astro.props;

const locale = getLocale();
const year = new Date().getFullYear();

// Ruta canónica (sin prefijo de idioma) de la página actual, para generar el
// selector de idioma y el hreflang con localizeHref(). Se quita la barra
// final (salvo en "/") para que las URLs generadas coincidan con las que
// escribía a mano el código anterior.
const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalPath = deLocalizeHref(normalizedPath);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={`https://vontus.dev${localizeHref(canonicalPath, { locale: l })}`} />
      ))
    }
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={localizeHref('/')}>vontus<span>.</span></a>
        <nav class="nav">
          <a href={localizeHref('/contacto')}>{m.nav_contacto()}</a>
          <span class="lang">
            {
              locales.map((l) => (
                <a href={localizeHref(canonicalPath, { locale: l })} class={l === locale ? 'active' : ''} hreflang={l}>
                  {l.toUpperCase()}
                </a>
              ))
            }
          </span>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {year} Alberto Martínez · vontus</span>
        <span>
          <a href="mailto:alberto@vontus.dev">alberto@vontus.dev</a> ·
          <a href="https://github.com/vontus" rel="me noopener" target="_blank">GitHub</a> ·
          <a
            href="https://www.linkedin.com/in/alberto-mart%C3%ADnez-bern%C3%A1-67945a167/"
            rel="me noopener"
            target="_blank">LinkedIn</a
          >
        </span>
      </div>
    </footer>
  </body>
</html>
